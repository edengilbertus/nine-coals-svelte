{
  "name": "nine-coals",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Eden Gilbert Kiseka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edengilbertus/nine-coals-svelte.git"
  },
  "homepage": "https://github.com/edengilbertus/nine-coals-svelte#readme",
  "bugs": {
    "url": "https://github.com/edengilbertus/nine-coals-svelte/issues"
  },
  "packageManager": "bun@1.3.14",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5179 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test": "bun run test:unit && bun run test:e2e",
    "assets": "bun scripts/fetch-assets.mjs",
    "check:svelte": "bun scripts/check-svelte.mjs",
    "screenshots": "bun scripts/screenshots.mjs"
  },
  "dependencies": {
    "@sveltejs/kit": "3.1.1",
    "gsap": "3.15.0",
    "leaflet": "1.9.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-vercel": "7.0.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
